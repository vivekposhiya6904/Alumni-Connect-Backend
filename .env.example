# =====================================================================
# GLS-CONNECT BACKEND CONFIGURATION TEMPLATE (.env.example)
# =====================================================================
# Copy this file to .env and configure your local or cloud values:
#   cp .env.example .env
#
# NOTE: .env is git-ignored. NEVER commit real credentials to GitHub.
# =====================================================================

# Server & Profile (Leave empty for local dev; set to 'prod' on Render)
SPRING_PROFILES_ACTIVE=
PORT=8080

# PostgreSQL Configuration
# Local: jdbc:postgresql://localhost:5432/alumni_db
# Render Singapore: jdbc:postgresql://dpg-dbfmsh291scs73anjv60-a:5432/alumni_db_nffw
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/alumni_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# MongoDB Configuration for Chat Storage
# Local: mongodb://localhost:27017/alumni_chat_db
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/alumni_chat_db?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/alumni_chat_db
MONGODB_DATABASE=alumni_chat_db

# JWT Authentication
# In production, specify a high-entropy cryptographically secure string (min 32 bytes / 256 bits)
JWT_SECRET=ThisIsASecretKeyForJwtGeneration123456
JWT_EXPIRATION_MS=2592000000

# Gmail SMTP Email (Account Verification & Password Reset)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_character_app_password

# CORS Allowed Origins (Comma-separated origins; mobile apps do not enforce browser CORS)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*,http://192.168.*

# File Upload Directory
APP_UPLOAD_DIR=uploads
