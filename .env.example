# =====================================================================
# GLS-CONNECT BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =====================================================================
# Copy this file to .env and provide your actual secrets.
# NEVER commit real credentials to Git.
# =====================================================================

# Server & Profile
SPRING_PROFILES_ACTIVE=
PORT=8080

# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/alumni_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# MongoDB Configuration for Chat Storage
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/alumni_chat_db
MONGODB_DATABASE=alumni_chat_db

# JWT Authentication (min 256-bit secure secret)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION_MS=2592000000

# Resend HTTPS Email Configuration (Recommended for Render & Production)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Legacy SMTP Configuration (Disabled on Render due to outbound port block)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*,http://192.168.*

# File Upload Directory
APP_UPLOAD_DIR=uploads
